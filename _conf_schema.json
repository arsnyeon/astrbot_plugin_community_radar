{
  "admin_uin": {
    "type": "string",
    "description": "主人账号",
    "hint": "定时推送与互动操作的默认对象。建议填写你的 QQ 号；留空且未填「推送目标」时不会主动推送。",
    "default": ""
  },
  "bili_cookie": {
    "type": "text",
    "description": "B 站 Cookie",
    "hint": "仅浏览、搜索、看评论时不需要填写。需要发评论或点赞时，粘贴包含 SESSDATA 与 bili_jct 的完整 Cookie。",
    "default": ""
  },
  "heybox_cookie": {
    "type": "text",
    "description": "小黑盒 Cookie",
    "hint": "仅浏览信息流与搜索时不需要填写。需要评论、点赞或发帖时，粘贴包含 pkey 与 x_xhh_tokenid 的完整 Cookie。",
    "default": ""
  },
  "browse": {
    "type": "object",
    "description": "定时浏览",
    "hint": "让她按自己的兴趣定时逛社区，并把看到的内容聊给你听。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用自动浏览",
        "hint": "开启后她会在下面这个时间区间里随机挑一个时间自己逛社区；不用你设具体几点。关闭时仍可用 /社区雷达 逛 手动触发。",
        "default": false
      },
      "interval_min_hours": {
        "type": "float",
        "description": "两次浏览的最小间隔（小时）",
        "hint": "她会在 min~max 之间随机决定下一次什么时候逛，避开静默时段。",
        "default": 1.0
      },
      "interval_max_hours": {
        "type": "float",
        "description": "两次浏览的最大间隔（小时）",
        "default": 5.0
      },
      "only_when_worth": {
        "type": "bool",
        "description": "只在真有话说时才发",
        "hint": "开启后，如果这次逛完觉得内容都很普通，她就不发消息，安安静静地看完；关闭则每次都会说点什么。",
        "default": true
      },
      "platforms": {
        "type": "string",
        "description": "浏览哪些社区",
        "hint": "all允许自主挑选三平台之一，both允许B站或小黑盒，亦可指定单平台。",
        "default": "all"
      },
      "interests_mode": {
        "type": "string",
        "description": "搜索关键词来源",
        "hint": "auto = 完全由模型按自己的人格和最近看到的内容决定想搜什么（不需要你定关键词）；manual = 只用下面「感兴趣的关键词」；hybrid = 你定的 + 模型自己想的。默认 auto。",
        "default": "auto"
      },
      "interests": {
        "type": "list",
        "description": "感兴趣的关键词（备用种子）",
        "hint": "只在 interests_mode 为 manual 或 hybrid 时使用；auto 模式下会完全忽略这里，由模型自己决定。",
        "default": []
      },
      "search_per_run": {
        "type": "int",
        "description": "每次搜索几个关键词",
        "hint": "每次定时浏览随机挑选的兴趣词数量，0 表示只按兴趣筛选热门、不额外搜索。",
        "default": 2
      },
      "persona": {
        "type": "text",
        "description": "浏览时的口吻",
        "hint": "留空跟随AstrBot会话人格；无法读取时才使用通用口吻。",
        "default": ""
      },
      "mode": {
        "type": "string",
        "description": "推送形式",
        "hint": "links = 只发标题与链接；summary = 由模型按自己的偏好挑几条聊聊再发。",
        "default": "summary"
      },
      "count": {
        "type": "int",
        "description": "每个社区取几条",
        "hint": "单次浏览每个社区最多纳入多少条内容。",
        "default": 5
      },
      "quiet_hours": {
        "type": "string",
        "description": "免打扰时段",
        "hint": "这段时间内不推送。例如 1-6 表示凌晨 1 点到 6 点；留空表示全天可推送。",
        "default": "1-6"
      },
      "targets": {
        "type": "list",
        "description": "推送目标",
        "hint": "填写完整会话标识（UMO），例如 平台名:FriendMessage:QQ号 或 平台名:GroupMessage:群号。留空则私聊「主人账号」。",
        "default": []
      },
      "ai_provider_id": {
        "type": "string",
        "description": "点评使用的模型",
        "hint": "留空则使用当前会话的默认对话模型。",
        "default": "",
        "_special": "select_provider"
      },
      "attach_image": {
        "type": "bool",
        "description": "浏览时带一张配图",
        "hint": "开启后，她发出来的那条会附上内容封面（B 站封面 / 小黑盒配图），不只是干巴巴的链接。配图取不到或发送失败会自动退回纯文字。",
        "default": true
      },
      "deep_read_when_topic": {
        "type": "bool",
        "description": "跟话题时多看几条",
        "hint": "如果这轮是因为聊天里提到才去搜的，会多补几条正文与热评，聊得更准；关掉则和随便逛一样只补 2 条。",
        "default": true
      },
      "enrich_max": {
        "type": "int",
        "description": "最多补几条正文",
        "hint": "单次浏览最多给多少条内容补正文 / 热评分。补得越多越准，也越慢。",
        "default": 5
      },
      "platform_weights": {
        "type": "object",
        "description": "平台偏好权重",
        "hint": "没有具体话题时，按权重随机决定这轮更想刷哪个平台。数值 1~5，越大越常去。",
        "items": {
          "bili": {
            "type": "int",
            "description": "B 站权重",
            "default": 3
          },
          "heybox": {
            "type": "int",
            "description": "小黑盒权重",
            "default": 3
          },
          "douyin": {
            "type": "int",
            "description": "抖音权重",
            "default": 2
          }
        }
      },
      "deep_watch_per_run": {
        "type": "int",
        "description": "每轮认真理解几条内容",
        "default": 2,
        "hint": "0关闭深看与内容点评；建议1～2。"
      },
      "run_timeout_seconds": {
        "type": "int",
        "description": "一轮浏览的总时间预算（秒）",
        "default": 600
      },
      "following_updates": {
        "type": "bool",
        "description": "候选加入关注UP的更新",
        "default": true,
        "hint": "需要B站登录态；失败时仍可使用热门和搜索。"
      }
    }
  },
  "topic": {
    "type": "object",
    "description": "话题监听",
    "hint": "她会从群聊 / 私聊里留意「自己也想去看一眼」的东西，记成待搜话题，下次浏览优先去搜。只做记录，不会因为它插话。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用话题监听",
        "default": true
      },
      "min_chars": {
        "type": "int",
        "description": "最短多少字才看",
        "hint": "太短的消息基本没信息量，直接跳过。",
        "default": 6
      },
      "max_chars": {
        "type": "int",
        "description": "最长多少字才看",
        "hint": "超长的多半是粘贴的公告或代码，不当话题。",
        "default": 120
      },
      "batch_size": {
        "type": "int",
        "description": "攒几条问一次模型",
        "hint": "条数越多越省调用，但话题会滞后一点。默认 4。",
        "default": 4
      },
      "scan_cooldown_sec": {
        "type": "int",
        "description": "同一会话两次判断的间隔（秒）",
        "hint": "避免群里聊得热闹时反复调用模型。默认 180 秒。",
        "default": 180
      },
      "ttl_hours": {
        "type": "int",
        "description": "话题保留多久（小时）",
        "hint": "超过这个时间还没去搜就丢掉，避免越攒越多。默认 12 小时。",
        "default": 12
      },
      "ignore_sessions": {
        "type": "list",
        "description": "不监听的会话",
        "hint": "填完整会话标识，例如某些不想让她跟着联想的群。",
        "default": []
      },
      "ai_provider_id": {
        "type": "string",
        "description": "判断话题用的模型",
        "hint": "留空则用当前默认对话模型。这个判断调用很轻，用便宜快的模型就够。",
        "default": "",
        "_special": "select_provider"
      }
    }
  },
  "group_share": {
    "type": "object",
    "description": "群聊分享",
    "hint": "除了私聊主人，也允许她在群里顺便说一句。群里只在她真有话说、且抽中时才发，不会每次都刷屏。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "允许在群里分享",
        "default": false
      },
      "sessions": {
        "type": "list",
        "description": "允许分享的群",
        "hint": "填群号或完整会话标识（平台名:GroupMessage:群号）。留空则只私聊主人。",
        "default": []
      },
      "probability": {
        "type": "float",
        "description": "每个群被选中的概率",
        "hint": "0~1。默认 0.35 表示大约三次浏览里有一次会顺带在群里说。",
        "default": 0.35
      }
    }
  },
  "link_peek": {
    "type": "object",
    "description": "分享链接接话",
    "hint": "有人发社区链接时，先替她看一眼内容，再让她接着聊，而不是只回一句「收到」。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用链接接话",
        "hint": "开启后会把链接内容加入本轮对话上下文，不会额外发送消息，也不打断正常聊天。",
        "default": true
      },
      "platforms": {
        "type": "string",
        "description": "识别哪些平台",
        "hint": "all = 全部，或按需填写 bili / douyin / heybox。",
        "default": "all"
      },
      "cooldown_sec": {
        "type": "int",
        "description": "同一会话冷却时间（秒）",
        "hint": "短时间内重复出现相同或不同链接时，避免反复解析。",
        "default": 30
      },
      "max_links": {
        "type": "int",
        "description": "单条消息最多解析几个链接",
        "hint": "防止一次转发大量链接导致请求过多。",
        "default": 2
      }
    }
  },
  "douyin": {
    "type": "object",
    "description": "抖音",
    "hint": "热榜与链接接话开箱可用；推荐流、点赞、评论、站内分享需要按需启用浏览器。登录状态会自动保存，无需手动设置路径。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用推荐流与互动",
        "hint": "关闭时热榜与链接接话仍可用；开启后可刷推荐流、点赞、评论、分享。首次使用需安装浏览器运行时并扫码登录。",
        "default": false
      },
      "dry_run": {
        "type": "bool",
        "description": "试运行",
        "hint": "开启时只记录、不真的点赞或评论，也不会真的发站内私信。建议先观察几天再关闭。",
        "default": true
      },
      "auto_browse": {
        "type": "bool",
        "description": "定时刷推荐流",
        "hint": "开启后按间隔自动浏览；关闭时只在手动触发时运行。运行期间会额外占用内存。",
        "default": false
      },
      "interval_hours": {
        "type": "float",
        "description": "自动浏览间隔（小时）",
        "hint": "两次自动浏览之间的大致间隔，实际会加入少量随机浮动。",
        "default": 4.0
      },
      "close_after_run": {
        "type": "bool",
        "description": "结束后关闭浏览器",
        "hint": "关闭后释放资源，登录状态仍会保留。建议在资源有限的环境保持开启。",
        "default": true
      },
      "owner_input": {
        "type": "string",
        "description": "主人的抖音号",
        "hint": "可填抖音号或主页链接。填写后需执行 /抖音 核对主人 完成身份核对；改动此项必须重新核对。留空则只通过聊天平台分享。",
        "default": ""
      },
      "share_to": {
        "type": "string",
        "description": "分享渠道",
        "hint": "qq = 只发到聊天平台，douyin = 只发抖音私信视频卡片，both = 两边都发。站内分享失败时自动回退到聊天平台。",
        "default": "qq"
      },
      "max_watch_per_day": {
        "type": "int",
        "description": "每天最多浏览视频数",
        "hint": "控制自动浏览的规模，避免过度请求。",
        "default": 20
      },
      "max_writes_per_day": {
        "type": "int",
        "description": "每天最多互动次数",
        "hint": "点赞、评论、分享、私信合计上限。",
        "default": 15
      },
      "min_write_gap_sec": {
        "type": "int",
        "description": "两次互动最小间隔（秒）",
        "hint": "相邻互动之间至少等待的时间，模拟正常浏览节奏。",
        "default": 90
      },
      "new_account_days": {
        "type": "int",
        "description": "新号保护期（天）",
        "hint": "登录后的这段时间内，所有互动上限减半；填 0 关闭。",
        "default": 7
      },
      "caps": {
        "type": "object",
        "description": "每日互动上限",
        "hint": "分别限制每类互动的次数。",
        "items": {
          "like": {
            "type": "int",
            "description": "每天最多点赞",
            "default": 10
          },
          "comment": {
            "type": "int",
            "description": "每天最多评论",
            "default": 5
          },
          "share": {
            "type": "int",
            "description": "每天最多分享",
            "default": 3
          }
        }
      },
      "ai_provider_id": {
        "type": "string",
        "description": "浏览时使用的模型",
        "hint": "用于判断要不要点赞、评论、分享。留空则使用当前会话的默认模型。",
        "default": "",
        "_special": "select_provider"
      },
      "targets": {
        "type": "list",
        "description": "推送目标",
        "hint": "填写完整会话标识（UMO）。留空则私聊「主人账号」。",
        "default": []
      }
    }
  },
  "bili": {
    "type": "object",
    "description": "B 站自主浏览",
    "hint": "让它自己刷 B 站推荐流，按喜好点赞或评论。写操作需要先在「B 站 Cookie」里填登录态。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用自主浏览",
        "default": false
      },
      "dry_run": {
        "type": "bool",
        "description": "试运行",
        "hint": "开启时只记录「本来想做什么」，不真的点赞评论。建议先开几天看看。",
        "default": true
      },
      "auto_browse": {
        "type": "bool",
        "description": "定时自己刷",
        "hint": "按下面的间隔自动刷推荐流并互动。",
        "default": false
      },
      "interval_hours": {
        "type": "float",
        "description": "自动刷的间隔（小时）",
        "default": 4
      },
      "caps": {
        "type": "object",
        "description": "每日互动上限",
        "items": {
          "like": {
            "type": "int",
            "description": "每天最多点赞",
            "default": 3
          },
          "comment": {
            "type": "int",
            "description": "每天最多评论",
            "default": 2
          }
        }
      },
      "min_write_gap_sec": {
        "type": "int",
        "description": "两次操作最小间隔（秒）",
        "default": 120
      },
      "ai_provider_id": {
        "type": "string",
        "description": "挑视频用的模型",
        "hint": "留空则使用当前会话的默认模型。",
        "default": "",
        "_special": "select_provider"
      },
      "owner_mid": {
        "type": "string",
        "description": "主人的 B 站号（UID）",
        "hint": "B 站私信分享用。是纯数字 UID（点开个人主页，网址 space.bilibili.com/ 后面那串），不是 QQ 号也不是昵称。留空则不走 B 站私信。",
        "default": ""
      },
      "share_to": {
        "type": "string",
        "description": "分享渠道",
        "hint": "qq = 只发聊天平台，bili = 只发 B 站私信，both = 两边都发。B 站私信需要登录态 + 主人的 B 站号。",
        "default": "qq"
      }
    }
  },
  "share": {
    "type": "object",
    "description": "主动分享",
    "hint": "允许它自己看到有趣的内容时，主动私聊分享给你。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "允许主动分享",
        "default": true
      },
      "cooldown_sec": {
        "type": "int",
        "description": "两次分享的最小间隔（秒）",
        "hint": "避免短时间连着发，默认 10 分钟。",
        "default": 600
      },
      "max_per_day": {
        "type": "int",
        "description": "每天最多分享几条",
        "default": 8
      },
      "segment": {
        "type": "bool",
        "description": "分成几条短消息发",
        "hint": "开启后由模型自己决定拆成 1~3 条，像 QQ 聊天一样分条发送；关闭则合成一段。平台侧评论仍保持单条，不会被拆成多条评论。",
        "default": true
      },
      "segment_max": {
        "type": "int",
        "description": "最多分几条",
        "hint": "建议 2~4 条；拆得太多会像刷屏。",
        "default": 3
      },
      "segment_delay": {
        "type": "float",
        "description": "分条之间的间隔（秒）",
        "hint": "默认 1.2 秒，实际会在基础上加一点随机抖动，避免机械感。",
        "default": 1.2
      },
      "auto_followup": {
        "type": "bool",
        "description": "分享后自动带上摘要",
        "hint": "分享后的短时间内，同一会话的追问会自动带上标题、链接和摘要，不必等模型自己想起来查记忆。",
        "default": true
      },
      "followup_minutes": {
        "type": "int",
        "description": "摘要跟随追问的窗口（分钟）",
        "default": 45
      },
      "group_recall_minutes": {
        "type": "int",
        "description": "群聊可回忆本群分享的时长（分钟）",
        "hint": "只回忆本群分享过的内容，不读取私聊或其他群的内容。",
        "default": 180
      }
    }
  },
  "video": {
    "type": "object",
    "description": "视频理解",
    "hint": "有人发 B 站视频链接时，先把视频看懂再接话：优先读字幕，没字幕就抽帧描述画面。字幕接口需要登录态，建议在「B 站 Cookie」里填上。",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用视频理解",
        "default": true
      },
      "max_transcript_chars": {
        "type": "int",
        "description": "分段概括后的文字预算",
        "default": 3000,
        "hint": "长字幕逐段处理，避免只取开头。"
      },
      "use_frames": {
        "type": "bool",
        "description": "没字幕时抽帧描述画面",
        "hint": "需要配置支持图片输入的模型；关掉则只看简介。",
        "default": true
      },
      "frames": {
        "type": "int",
        "description": "关键帧数量",
        "default": 6,
        "hint": "1～12，覆盖开头、中间和结尾；字幕与画面一起使用。"
      },
      "provider_id": {
        "type": "string",
        "description": "画面描述用的模型",
        "hint": "留空则使用当前会话的默认模型。",
        "default": "",
        "_special": "select_provider"
      },
      "audio_transcription": {
        "type": "bool",
        "description": "没字幕时转写音轨",
        "hint": "把视频声音交给支持音频输入的模型转成文字，比只看画面更贴近原意。需要模型支持音频。",
        "default": false
      },
      "audio_provider_id": {
        "type": "string",
        "description": "音轨转写用的模型",
        "hint": "留空则用上面的画面描述模型。",
        "default": "",
        "_special": "select_provider"
      },
      "audio_seconds": {
        "type": "int",
        "description": "音频总处理时长上限",
        "default": 180,
        "hint": "没有字幕时按180秒分段转写；超过预算明确标记。"
      },
      "timeout_seconds": {
        "type": "int",
        "description": "单条内容时间预算（秒）",
        "default": 150
      }
    }
  },
  "learning": {
    "type": "object",
    "description": "观看记忆与兴趣",
    "items": {
      "enable": {
        "type": "bool",
        "description": "从可靠内容生成感想和偏好",
        "default": true
      },
      "ai_provider_id": {
        "type": "string",
        "description": "内容概括与感想模型",
        "default": ""
      }
    }
  },
  "activity": {
    "type": "object",
    "description": "日程与回顾",
    "items": {
      "daily_plan": {
        "type": "bool",
        "description": "模型安排当天浏览时间",
        "default": false,
        "hint": "关闭时沿用随机间隔；开启后空计划表示当天不浏览。"
      },
      "weekly_push": {
        "type": "bool",
        "description": "周日晚上分享浏览周记",
        "default": false,
        "hint": "仍受分享开关、每日上限和冷却约束。"
      },
      "ai_provider_id": {
        "type": "string",
        "description": "日程模型",
        "default": ""
      }
    }
  },
  "bangumi": {
    "type": "object",
    "description": "番剧与单集记忆",
    "items": {
      "enable": {
        "type": "bool",
        "description": "启用搜索、追番列表和单集理解",
        "default": false,
        "hint": "使用账号正常可播放的内容；抽帧或部分转写会说明覆盖范围。"
      }
    }
  },
  "inbox": {
    "type": "object",
    "description": "B站新通知与私信",
    "items": {
      "enable": {
        "type": "bool",
        "description": "监听新通知",
        "default": false,
        "hint": "首次读取仅建立游标，不回复旧消息。沿用B站试运行设置。"
      },
      "comments": {
        "type": "bool",
        "description": "处理评论回复和@通知",
        "default": false
      },
      "private_messages": {
        "type": "bool",
        "description": "处理新私信",
        "default": false
      },
      "allowed_uids": {
        "type": "list",
        "description": "允许回复的B站UID",
        "default": [],
        "hint": "同时允许bili.owner_mid；未绑定主人且白名单为空时不处理。"
      },
      "poll_seconds": {
        "type": "int",
        "description": "轮询间隔（秒）",
        "default": 300
      },
      "max_per_day": {
        "type": "int",
        "description": "每位用户每日私信回复上限",
        "default": 5
      }
    }
  },
  "bili_actions": {
    "type": "object",
    "description": "B站扩展动作",
    "items": {
      "coin": {
        "type": "bool",
        "description": "允许投币",
        "default": false,
        "hint": "每次1枚，沿用B站试运行。"
      },
      "favorite": {
        "type": "bool",
        "description": "允许收藏",
        "default": false
      },
      "follow": {
        "type": "bool",
        "description": "允许关注UP",
        "default": false
      },
      "dynamic": {
        "type": "bool",
        "description": "允许发布动态",
        "default": false
      },
      "folder_id": {
        "type": "string",
        "description": "收藏夹ID",
        "default": ""
      },
      "max_per_day": {
        "type": "int",
        "description": "每种扩展动作每日上限",
        "default": 2
      },
      "gap_seconds": {
        "type": "int",
        "description": "同种扩展动作最小间隔",
        "default": 300
      }
    }
  }
